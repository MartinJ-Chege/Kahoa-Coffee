/*
  Content-Security-Policy: default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: https: http:;
  Cache-Control: no-cache, no-store, must-revalidate
  X-Frame-Options: SAMEORIGIN

/*.html
  Cache-Control: no-cache, no-store, must-revalidate

/*.js
  Cache-Control: public, max-age=31536000

/*.png
  Cache-Control: public, max-age=31536000

/*.jpg
  Cache-Control: public, max-age=31536000

/wholesale.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
